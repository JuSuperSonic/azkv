            "request": "launch",
            "cargo": {
                "args": [
                    "test",
                    "--package=azkv-core"
                ]
            }
        },
        {
            "name": "Cli - Debug executable 'azkvctl'",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "run",
                    "--bin=azkvctl",
                    "--package=azkv-cli"
                ]
            },
            "args": []
        },
        {
            "name": "Cli - Debug unit tests in executable 'azkvctl'",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "test",
                    "--bin=azkvctl",
                    "--package=azkv-cli"
                ]
            }
        },
        {
            "name": "Tui - Debug executable 'azkv'",
